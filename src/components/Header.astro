---
import { SITE_TITLE } from '../consts';

const links = [
  { href: '/routes/', label: 'Routes' },
  { href: '/grading/', label: 'How I grade' },
];
const currentPath = Astro.url.pathname;
---

<header class="border-b border-neutral-200">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-5 sm:px-8">
    <a href="/" class="text-lg font-semibold tracking-tight">{SITE_TITLE}</a>
    <nav aria-label="Main">
      <ul class="flex items-center gap-6 text-sm font-medium sm:gap-8">
        {
          links.map(({ href, label }) => {
            const isActive = currentPath.startsWith(href);
            return (
              <li>
                <a
                  href={href}
                  aria-current={isActive ? 'page' : undefined}
                  class:list={[
                    'transition-colors hover:text-accent',
                    isActive ? 'text-accent' : 'text-neutral-700',
                  ]}
                >
                  {label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>
